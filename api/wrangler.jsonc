{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },

  // Checklist auto-generation (replaces node-cron "0 * * * *" + last-generate.txt).
  // "0 * * * *": checklist auto-generation (hourly check, once per month).
  // "* * * * *": Google Sheets backup sync (every minute; EM report pulled every 10 minutes).
  "triggers": { "crons": ["0 * * * *", "* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "epil-db",
      // Replace after `wrangler d1 create epil-db` (see docs/DEPLOYMENT.md).
      "database_id": "61c6d8e7-65eb-48df-96dc-05e500eef527",
      "migrations_dir": "migrations"
    }
  ],
  // File storage: Cloudinary (public URLs, same as the legacy system). To switch to a private
  // R2 bucket instead, add  "r2_buckets": [{ "binding": "FILES", "bucket_name": "epil-files" }]
  // and set FILE_STORAGE to "r2".

  "vars": {
    // Comma-separated list of allowed browser origins for CORS.
    "CORS_ORIGINS": "https://epil-portal.epil.workers.dev,https://epil-admin.epil.workers.dev,http://localhost:3000,http://localhost:3001",
    "PUBLIC_API_URL": "https://epil-api.epil.workers.dev",
    "MAX_UPLOAD_BYTES": "5242880",
    "FILE_STORAGE": "cloudinary",
    // D1 → Google Sheets backup. Turn on only after the old portal has stopped writing to the sheets.
    "SHEETS_SYNC_ENABLED": "false",
    "EM_SHEET_TAB_NAME": "EM SHEET WITH RITEH SIR",
    "CLOUDINARY_FOLDER": "employee_documents",
    "WHATSAPP_TEMPLATE_PENDING": "pendingtask",
    "WHATSAPP_TEMPLATE_WORKREPORT": "workreport",
    "WHATSAPP_API_VERSION": "v21.0"
  }

  // Secrets (set with `wrangler secret put <NAME>`, never commit):
  //   JWT_SECRET            – HS256 signing key for session tokens
  //   FILE_URL_SECRET       – HMAC key for signed R2 download URLs (only used with FILE_STORAGE=r2)
  //   CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET – uploads (FILE_STORAGE=cloudinary)
  //   META_WA_TOKEN         – WhatsApp Cloud API token
  //   META_WA_PHONE_ID      – WhatsApp phone number ID
  //   ADMIN_REGISTRATION_KEY – optional; required to self-register new admins
}
