{
  "name": "epil-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply epil-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply epil-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "4.20251111.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
